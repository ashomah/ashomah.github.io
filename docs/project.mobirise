          "_anchor": "header1-a",
          "_params": {
            "showTitle": true,
            "showText": true,
            "showButtons": true,
            "showArrow": false,
            "contentAlign": "center",
            "bgImageRadio": false,
            "bgImage": "@THEME_PATH@/components/_images/jumbotron.jpg",
            "parallax": true,
            "bgColorRadio": true,
            "bgColor": "#ffffff",
            "bgVideoRadio": false,
            "bgVideo": {
              "url": "https://www.youtube.com/watch?v=uNCr7NdOJgw"
            },
            "overlay": false,
            "overlayColor": "#000",
            "overlayOpacity": 0.5
          },
          "title": "Bonjour, I'm Ashley !",
          "text": "<br><span style=\"font-style: normal;\">I've always played with data.</span><br>Along with enabling teams to streamline their effort by designing and implementing efficient processes and driving transformation across multicultural business units,<br>I have generated various KPIs and insights --- using Excel.<br><span style=\"font-style: normal;\">I now have tremendously extended my skill set!<br></span><br>With innovation, technology, performance and teamwork in my DNA, I have initiated a career shift<br>to leverage on data technologies and create innovative data-led solutions with high impact.<br><br>With proven capacity to lead projects with cross-functional and international stakeholders,<br>I enriched my industrial engineering background with<br>an entrepreneur mindset, a business acumen, and a data science toolkit.<br><br>Insatiable explorer, I love to challenge myself and learn from every encounter.<br>I ambition to contribute to the community towards<br>enhanced lifestyle, social justice, and sustainable environment.<br>",
          "buttons": "  <a data-app-btn=\"true\" class=\"btn btn-lg btn-black-outline btn-black\" href=\"https://www.linkedin.com/in/ashleyomahony\" data-toolbar=\"-mbrBtnMove\" target=\"_blank\"><span class=\"socicon socicon-linkedin mbr-iconfont mbr-iconfont-btn\"></span>LINKEDIN</a> <a data-app-btn=\"true\" class=\"btn btn-lg btn-black-outline btn-black\" href=\"http://github.com/ashomah\" data-toolbar=\"-mbrBtnMove\" target=\"_blank\"><span class=\"socicon socicon-github mbr-iconfont mbr-iconfont-btn\"></span>GITHUB</a> <a data-app-btn=\"true\" class=\"btn btn-lg btn-black-outline btn-black\" href=\"https://twitter.com/AshleyOMahony\" data-toolbar=\"-mbrBtnMove\" target=\"_blank\"><span class=\"socicon socicon-twitter mbr-iconfont mbr-iconfont-btn\"></span>TWITTER</a> <a data-app-btn=\"true\" class=\"btn btn-lg btn-black-outline btn-black\" href=\"http://ashleyomahony.com/Ashley_OMahony.vcf\" data-toolbar=\"-mbrBtnMove\" target=\"_blank\"><span class=\"socicon socicon-persona mbr-iconfont mbr-iconfont-btn\"></span>VCARD</a> "
        },
